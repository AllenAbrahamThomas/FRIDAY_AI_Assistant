# FRIDAY AI Assistant - Environment Configuration
# Copy this file to .env and customize values for your local environment

PROJECT_NAME="FRIDAY AI Assistant"
VERSION="2.0.0"
ENVIRONMENT="development"

# CORS configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local LLM Host (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_RETRY_COUNT=2

# World Monitor API (without a key, explicitly labeled static sample data is used)
WORLD_MONITOR_API_KEY=""
WORLD_MONITOR_TIMEOUT_SECONDS=8.0
WORLD_MONITOR_RETRY_COUNT=1
SEARCH_TIMEOUT_SECONDS=8.0
WEATHER_TIMEOUT_SECONDS=8.0
# Reserved; the current Google News RSS search does not use this key.
NEWS_API_KEY=""
MEMORY_DB_PATH="backend/data/friday.sqlite3"

# Legacy server-host TTS. Browser voice controls use the local browser instead.
SERVER_TTS_ENABLED=false

# Logging
LOG_LEVEL="INFO"
